<ui:FluentWindow x:Class="Catalyst.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Catalyst.Windows"
        xmlns:root="clr-namespace:Catalyst"
        mc:Ignorable="d"
        Title="Catalyst" Height="620" Width="380"
        MinWidth="340" MinHeight="440"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <root:InverseBooleanConverter x:Key="InverseBool"/>
        <root:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <root:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVis"/>
        <root:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <root:NullToVisibilityConverter x:Key="NullToVis"/>

        <Style x:Key="DittoCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#1AFFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,2"
                                Padding="8,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2DFFFFFF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#35007ACC"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Search & Quick Actions -->
            <RowDefinition Height="*"/>    <!-- Apps List -->
            <RowDefinition Height="Auto"/> <!-- Status & Action Footer -->
        </Grid.RowDefinitions>

        <!-- TitleBar with Modern Fluent Window Controls -->
        <ui:TitleBar Grid.Row="0" Title="Catalyst" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/favicon.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Search Bar & Header Controls -->
        <Grid Grid.Row="1" Margin="12,2,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Name="TxtSearch"
                        Grid.Column="0"
                        PlaceholderText="Search apps... (1-9 to launch)"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        Margin="0,0,6,0"
                        TextChanged="TxtSearch_TextChanged"
                        KeyDown="TxtSearch_KeyDown"/>

            <ui:Button Name="BtnHeaderRefresh"
                       Grid.Column="1"
                       Icon="{ui:SymbolIcon ArrowClockwise20}"
                       Appearance="Secondary"
                       ToolTip="Reload Apps (F5)"
                       Margin="0,0,4,0"
                       Padding="8,6"
                       Click="BtnRefresh_Click"/>

            <ui:Button Name="BtnHeaderManage"
                       Grid.Column="2"
                       Icon="{ui:SymbolIcon Settings20}"
                       Appearance="Secondary"
                       ToolTip="Manage Apps (Ctrl+M)"
                       Padding="8,6"
                       Click="BtnManage_Click"/>
        </Grid>

        <!-- Main Apps List (Modern Ditto Style) -->
        <ListBox Name="LstApps"
                 Grid.Row="2"
                 Margin="12,0,12,0"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource DittoCardItemStyle}"
                 SelectionChanged="LstApps_SelectionChanged"
                 MouseDoubleClick="LstApps_MouseDoubleClick"
                 PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                 MouseMove="LstApps_MouseMove"
                 DragOver="LstApps_DragOver"
                 Drop="LstApps_Drop"
                 AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Start App" Click="CtxMenuStart_Click" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Play24" Foreground="#4ADE80"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Stop App" Click="CtxMenuStop_Click" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Stop24" Foreground="#F87171"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="View Live Logs" Click="CtxMenuLogs_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="#60A5FA"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Move Up" Click="CtxMenuMoveUp_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowUp24"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Move Down" Click="CtxMenuMoveDown_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowDown24"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Open Location / Folder" Click="CtxMenuOpenFolder_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="FolderOpen24"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy Target / Path" Click="CtxMenuCopyPath_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Copy24"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Edit in App Management" Click="CtxMenuEdit_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Edit24"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Shortcut Number -->
                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                            <ColumnDefinition Width="*"/>    <!-- Name & Subtitle -->
                            <ColumnDefinition Width="Auto"/> <!-- Status Pill & Actions -->
                        </Grid.ColumnDefinitions>

                        <!-- Shortcut Badge (e.g. 1-9) -->
                        <Border Grid.Column="0"
                                Width="20" Height="20"
                                CornerRadius="4"
                                Background="#30FFFFFF"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ShortcutIndex}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#60A5FA"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- App Icon / Label Badge -->
                        <Border Grid.Column="1"
                                Width="34" Height="34"
                                CornerRadius="6"
                                Margin="0,0,10,0"
                                Background="{Binding ColorBrush}"
                                ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Grid>
                                <!-- Icon Image -->
                                <Image Source="{Binding IconSource32}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderOptions.EdgeMode="Unspecified"
                                       Visibility="{Binding IconSource32, Converter={StaticResource NotNullToVis}}"/>
                                <!-- Fallback text badge if icon image is missing -->
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IconSource32, Converter={StaticResource NullToVis}}"/>
                            </Grid>
                        </Border>

                        <!-- Name and Path -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="#F8FAFC"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ShortLaunchTarget}"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Status Badge & Action Buttons -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Status Pill -->
                            <Border CornerRadius="10"
                                    Padding="6,2"
                                    Margin="0,0,6,0"
                                    Background="#1AFFFFFF"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{Binding StatusColor}"
                                             Margin="0,0,4,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IsRunningString}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{Binding StatusColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick Play/Stop Button -->
                            <ui:Button Appearance="Success"
                                       Icon="{ui:SymbolIcon Play16}"
                                       ToolTip="Launch (Space / Enter)"
                                       Padding="6,4"
                                       Margin="0,0,3,0"
                                       Tag="{Binding}"
                                       Click="BtnItemStart_Click"
                                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"/>

                            <ui:Button Appearance="Danger"
                                       Icon="{ui:SymbolIcon Stop16}"
                                       ToolTip="Stop Application"
                                       Padding="6,4"
                                       Margin="0,0,3,0"
                                       Tag="{Binding}"
                                       Click="BtnItemStop_Click"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

                            <!-- Quick Logs Button -->
                            <ui:Button Appearance="Secondary"
                                       Icon="{ui:SymbolIcon DocumentBulletList16}"
                                       ToolTip="Live Logs (Ctrl+L / Double-click)"
                                       Padding="6,4"
                                       Tag="{Binding}"
                                       Click="BtnItemLogs_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Modern Footer & Action Bar -->
        <Border Grid.Row="3"
                Background="#10FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Summary and Hotkey -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Name="StatusDot" Width="7" Height="7" Fill="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Name="LblStatus" Text="Ready" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock Name="LblHotkeyHint" Text=" • Hotkey: Alt+Space" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Batch Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Name="BtnStartAll"
                               Content="Start All"
                               Icon="{ui:SymbolIcon Play16}"
                               Appearance="Secondary"
                               FontSize="11"
                               Padding="8,4"
                               Margin="0,0,4,0"
                               Click="BtnStartAll_Click"/>
                    <ui:Button Name="BtnStopAll"
                               Content="Stop All"
                               Icon="{ui:SymbolIcon Stop16}"
                               Appearance="Secondary"
                               FontSize="11"
                               Padding="8,4"
                               Click="BtnStopAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
