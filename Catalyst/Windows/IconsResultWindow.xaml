<ui:FluentWindow x:Class="Catalyst.Windows.IconsResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Catalyst.Windows"
        Title="Generated Icons" Height="500" Width="680"
        Icon="pack://application:,,,/favicon.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Catalyst - Generated Icons">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/favicon.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" Margin="12,0,12,12" Background="Transparent">
            <ItemsControl Name="IconsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                CornerRadius="8" Margin="8" Padding="12" Width="140">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="100" Height="100" Background="Transparent" CornerRadius="8" ClipToBounds="True">
                                    <Image Source="{Binding IconSource}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderOptions.EdgeMode="Unspecified"/>
                                </Border>
                                <TextBlock Text="{Binding AppName}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                           FontWeight="SemiBold" Foreground="#F8FAFC" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#10FFFFFF" Padding="12,10" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0">
            <ui:Button Content="Open Icons Folder in Explorer"
                       Icon="{ui:SymbolIcon FolderOpen24}"
                       Appearance="Primary"
                       Height="40"
                       HorizontalAlignment="Stretch"
                       Click="BtnOpenFolder_Click"
                       FontSize="14"/>
        </Border>
    </Grid>
</ui:FluentWindow>