<ui:FluentWindow x:Class="Catalyst.Windows.AppManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Catalyst.Windows"
        xmlns:root="clr-namespace:Catalyst"
        mc:Ignorable="d"
        Title="Catalyst - App Management" Height="780" Width="920"
        Icon="pack://application:,,,/favicon.ico"
        MinWidth="800" MinHeight="900"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <root:InverseBooleanConverter x:Key="InverseBool"/>
        <root:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <root:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVis"/>
        <root:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <root:NullToVisibilityConverter x:Key="NullToVis"/>

        <Style x:Key="ManageAppListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#10FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#35007ACC"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Global Action Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Catalyst - App Management" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/favicon.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Top Action Toolbar above Application Settings area -->
        <Border Grid.Row="1" Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="14,0,14,10">
            <DockPanel>
                <TextBlock Name="LblGenesisStatus" Text="Ready" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0" DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Name="BtnSave" Content="Save"
                               Icon="{ui:SymbolIcon Save20}"
                               Appearance="Success"
                               Margin="0,0,8,0"
                               Click="BtnSave_Click"/>
                    <ui:Button Name="BtnGenerate" Content="Generate All Icons"
                               Icon="{ui:SymbolIcon Image20}"
                               Appearance="Secondary"
                               Click="BtnGenerate_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Apps List & Management Actions -->
            <Border Grid.Column="0" Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <!-- Bottom Action Toolbar -->
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
                        <!-- Add Application Button -->
                        <ui:Button Name="BtnAdd" Content="Add Application"
                                   Icon="{ui:SymbolIcon Add20}"
                                   Appearance="Secondary"
                                   Height="34"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   ToolTip="Add a new application"
                                   Click="BtnAdd_Click"/>
                    </Border>

                    <!-- Apps List Header -->
                    <TextBlock DockPanel.Dock="Top" Text="Configured Apps" FontWeight="SemiBold" FontSize="13" Foreground="#E2E8F0" Margin="2,0,0,8"/>

                    <!-- Apps List -->
                    <ListBox Name="LstApps"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ManageAppListItemStyle}"
                             SelectionChanged="LstApps_SelectionChanged"
                             PreviewKeyDown="LstApps_PreviewKeyDown"
                             PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                             MouseMove="LstApps_MouseMove"
                             DragOver="LstApps_DragOver"
                             Drop="LstApps_Drop"
                             AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Center">
                                        <Grid>
                                            <Border Background="{Binding ColorBrush}"
                                                    CornerRadius="6"
                                                    Visibility="{Binding IconSource, Converter={StaticResource NullToVis}}"/>
                                            <Image Source="{Binding IconSource}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   RenderOptions.EdgeMode="Unspecified"
                                                   Visibility="{Binding IconSource, Converter={StaticResource NotNullToVis}}"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IconSource, Converter={StaticResource NullToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                            <Border Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}" Background="#30F59E0B" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Hidden" FontSize="9" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LaunchTypeDescription}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Panel: App Configuration -->
            <Border Grid.Column="1" Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Application Settings" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2038bdf8" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Name="LblTypeBadge" Text="Application" FontSize="11" FontWeight="Medium" Foreground="#38BDF8"/>
                            </Border>
                            <ui:Button Name="BtnRemove" Content="Remove App"
                                       Icon="{ui:SymbolIcon Delete20}"
                                       Appearance="Danger"
                                       Height="30"
                                       FontSize="11"
                                       Padding="10,4"
                                       VerticalAlignment="Center"
                                       ToolTip="Remove this application"
                                       Click="BtnRemove_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dedicated Previews Section: Live vs Generated -->
                    <Border Grid.Row="1" Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ICON PREVIEWS" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                                    <TextBlock Text="Compare real-time configuration changes with saved generated icons" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ui:Button Name="BtnRegenerateCurrent" Grid.Column="1" Content="Generate This Icon"
                                           Icon="{ui:SymbolIcon ArrowClockwise16}"
                                           Appearance="Secondary" Padding="10,4" FontSize="12"
                                           Click="BtnRegenerateCurrent_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Live Previews Box -->
                                <Border Grid.Column="0" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="Live" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                            <TextBlock Text="(Live changes)" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <StackPanel Margin="0,0,16,0" HorizontalAlignment="Center">
                                                <TextBlock Text="512x512" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                <Border Width="64" Height="64" Background="#0FFFFFFF" CornerRadius="8" ClipToBounds="True">
                                                    <Image Source="{Binding SelectedItem.LivePreviewSource, ElementName=LstApps}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,14,0" HorizontalAlignment="Center">
                                                <TextBlock Text="48x48" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                <Border Width="48" Height="48" Background="#0FFFFFFF" CornerRadius="6" ClipToBounds="True">
                                                    <Image Source="{Binding SelectedItem.LivePreviewSource48, ElementName=LstApps}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,14,0" HorizontalAlignment="Center">
                                                <TextBlock Text="32x32" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                <Border Width="32" Height="32" Background="#0FFFFFFF" CornerRadius="4" ClipToBounds="True">
                                                    <Image Source="{Binding SelectedItem.LivePreviewSource32, ElementName=LstApps}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <TextBlock Text="16x16" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                <Border Width="16" Height="16" Background="#0FFFFFFF" CornerRadius="3" ClipToBounds="True">
                                                    <Image Source="{Binding SelectedItem.LivePreviewSource16, ElementName=LstApps}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Generated Previews Box -->
                                <Border Grid.Column="1" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="Generated" FontWeight="Bold" FontSize="11" Foreground="#34D399"/>
                                            <TextBlock Text="(Saved icons)" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <StackPanel Margin="0,0,16,0" HorizontalAlignment="Center">
                                                <TextBlock Text="512x512" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                <Border Width="64" Height="64" Background="#0FFFFFFF" CornerRadius="8" ClipToBounds="True">
                                                    <Image Source="{Binding SelectedItem.IconSource, ElementName=LstApps}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,14,0" HorizontalAlignment="Center">
                                                <TextBlock Text="48x48" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                <Border Width="48" Height="48" Background="#0FFFFFFF" CornerRadius="6" ClipToBounds="True">
                                                    <Image Source="{Binding SelectedItem.IconSource48, ElementName=LstApps}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,14,0" HorizontalAlignment="Center">
                                                <TextBlock Text="32x32" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                <Border Width="32" Height="32" Background="#0FFFFFFF" CornerRadius="4" ClipToBounds="True">
                                                    <Image Source="{Binding SelectedItem.IconSource32, ElementName=LstApps}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <TextBlock Text="16x16" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                <Border Width="16" Height="16" Background="#0FFFFFFF" CornerRadius="3" ClipToBounds="True">
                                                    <Image Source="{Binding SelectedItem.IconSource16, ElementName=LstApps}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Category Tabs -->
                    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                        <!-- Tab 1: Launch Configuration -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                    <ui:SymbolIcon Symbol="Play20" Margin="0,0,6,0"/>
                                    <TextBlock Text="Launch" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <!-- Target & Execution Card -->
                                    <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="TARGET &amp; EXECUTION" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>

                                            <TextBlock Text="Application Name" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                            <ui:TextBox Name="TxtAppName" PlaceholderText="e.g. FlightPlan, VS Code, Chrome"
                                                        TextChanged="Config_TextChanged" Margin="0,0,0,10"/>

                                            <TextBlock Text="Launch Target (.exe / .csproj / .sln / .bat / .ps1 / URL / shortcut)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Name="TxtProjectPath" PlaceholderText="e.g. C:\Program Files\App\app.exe or FlightPlan\FlightPlan.csproj"
                                                            TextChanged="Config_TextChanged" Margin="0,0,6,0"/>
                                                <ui:Button Name="BtnBrowseTarget" Grid.Column="1" Content="Browse..."
                                                           Icon="{ui:SymbolIcon FolderOpen20}"
                                                           Appearance="Secondary"
                                                           Click="BtnBrowseTarget_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Arguments (Optional)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <ui:TextBox Name="TxtArguments" PlaceholderText="--profile dev, -v"
                                                                TextChanged="Config_TextChanged"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Working Directory (Optional)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Name="TxtWorkingDirectory" PlaceholderText="C:\WorkingDir"
                                                                    TextChanged="Config_TextChanged" Margin="0,0,4,0"/>
                                                        <ui:Button Name="BtnBrowseWorkingDir" Grid.Column="1" Content="..."
                                                                   Appearance="Secondary" Padding="8,4"
                                                                   Click="BtnBrowseWorkingDir_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Launch Behavior Card -->
                                    <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="LAUNCH BEHAVIOR &amp; VISIBILITY" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>

                                            <CheckBox Name="ChkRunAsAdmin" Content="Run as Administrator"
                                                      Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"
                                                      Checked="Config_CheckChanged" Unchecked="Config_CheckChanged"/>

                                            <CheckBox Name="ChkIsHidden" Content="Hide from Main Window (Visible in App Manager only)"
                                                      Foreground="#CBD5E1" FontSize="12"
                                                      Checked="Config_CheckChanged" Unchecked="Config_CheckChanged"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Appearance & Styling -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                    <ui:SymbolIcon Symbol="Color20" Margin="0,0,6,0"/>
                                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <!-- Background & Palette Card -->
                                    <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="BACKGROUND &amp; COLORS" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Background Style -->
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Background Style" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <ComboBox Name="CmbBackgroundType" SelectionChanged="Config_SelectionChanged" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Solid Color" Tag="Solid"/>
                                                        <ComboBoxItem Content="2-Part Gradient" Tag="Gradient"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Primary Color / Start Color -->
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Name="LblColor" Text="Color (Hex)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Name="TxtColor" PlaceholderText="#1E88E4"
                                                                    TextChanged="Config_TextChanged" Margin="0,0,4,0"/>
                                                        <Border Name="ColorPreviewBorder" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#1E88E4" BorderBrush="#50FFFFFF" BorderThickness="1" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to open Color Wheel Picker" MouseLeftButtonUp="BtnPickColor_Click"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Secondary Color / Gradient End Color -->
                                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                                    <TextBlock Name="LblSecondaryColor" Text="Gradient End (Hex)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Name="TxtSecondaryColor" PlaceholderText="#DD2476"
                                                                    TextChanged="Config_TextChanged" Margin="0,0,4,0"/>
                                                        <Border Name="SecondaryColorPreviewBorder" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#DD2476" BorderBrush="#50FFFFFF" BorderThickness="1" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to open Color Wheel Picker" MouseLeftButtonUp="BtnPickSecondaryColor_Click"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Gradient Direction -->
                                                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                                    <TextBlock Name="LblGradientDirection" Text="Gradient Direction" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <ComboBox Name="CmbGradientDirection" SelectionChanged="Config_SelectionChanged" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Diagonal (TL ↘ BR)" Tag="Diagonal"/>
                                                        <ComboBoxItem Content="Vertical (Top ↓ Bottom)" Tag="Vertical"/>
                                                        <ComboBoxItem Content="Horizontal (Left → Right)" Tag="Horizontal"/>
                                                        <ComboBoxItem Content="Diagonal Up (BL ↗ TR)" Tag="DiagonalUp"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Badge Label & Glyph Styling Card -->
                                    <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="BADGE LABEL &amp; GLYPH STYLING" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Label / Badge Text" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <ui:TextBox Name="TxtLabel" PlaceholderText="FP"
                                                                TextChanged="Config_TextChanged"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="Glyph Tint (Hex)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Name="TxtGlyphColor" PlaceholderText="#FFFFFF"
                                                                    TextChanged="Config_TextChanged" Margin="0,0,4,0"/>
                                                        <Border Name="GlyphColorPreviewBorder" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#FFFFFF" BorderBrush="#50FFFFFF" BorderThickness="1" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to open Color Wheel Picker" MouseLeftButtonUp="BtnPickGlyphColor_Click"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="Bootstrap Icon Name" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                                    <ui:TextBox Name="TxtBootstrapIcon" PlaceholderText="e.g. send, copy, play"
                                                                TextChanged="Config_TextChanged"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Custom SVG Glyph & Override Card -->
                                    <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="CUSTOM SVG GLYPH &amp; OVERRIDE" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>

                                            <!-- Custom Glyph SVG -->
                                            <TextBlock Text="Custom Glyph SVG (File path or SVG XML / path data)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Name="TxtCustomGlyphSvg" PlaceholderText="e.g. icons\custom-glyph.svg or SVG XML"
                                                            TextChanged="Config_TextChanged" Margin="0,0,6,0"/>
                                                <ui:Button Name="BtnBrowseGlyphSvg" Grid.Column="1" Content="Browse SVG..."
                                                           Icon="{ui:SymbolIcon Image20}"
                                                           Appearance="Secondary"
                                                           Click="BtnBrowseGlyphSvg_Click"/>
                                            </Grid>

                                            <!-- Complete SVG Override -->
                                            <TextBlock Text="Complete SVG Override (Replaces entire icon tile with full SVG)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Name="TxtSvgOverride" PlaceholderText="e.g. icons\full-icon.svg or complete SVG XML"
                                                            TextChanged="Config_TextChanged" Margin="0,0,6,0"/>
                                                <ui:Button Name="BtnBrowseSvgOverride" Grid.Column="1" Content="Browse SVG..."
                                                           Icon="{ui:SymbolIcon Image20}"
                                                           Appearance="Secondary"
                                                           Click="BtnBrowseSvgOverride_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: Developer -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                    <ui:SymbolIcon Symbol="Code20" Margin="0,0,6,0"/>
                                    <TextBlock Text="Developer" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <!-- .catalyst Repo Pack Card -->
                                    <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text=".CATALYST PROJECT PACK" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                                                    <TextBlock Text="Pack app settings and branding assets into a .catalyst folder in the project repository" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ui:Button Name="BtnExportCatalyst" Grid.Column="1" Content="Export .catalyst Folder"
                                                           Icon="{ui:SymbolIcon ArrowDownload16}"
                                                           Appearance="Primary" Padding="10,4" FontSize="12"
                                                           Click="BtnExportCatalyst_Click"/>
                                            </Grid>

                                            <TextBlock Text=".catalyst Directory Location (Optional - defaults to .catalyst in project directory)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Name="TxtCatalystDirectory" PlaceholderText=".catalyst"
                                                            TextChanged="Config_TextChanged" Margin="0,0,4,0"/>
                                                <ui:Button Name="BtnBrowseCatalystDir" Grid.Column="1" Content="..."
                                                           Appearance="Secondary" Padding="8,4"
                                                           Click="BtnBrowseCatalystDir_Click"/>
                                            </Grid>
                                            <TextBlock Text="Specifies the location of the .catalyst directory in the app's repository. Exporting saves app config and all assets needed to generate branding on another machine."
                                                       Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Project Favicon Card -->
                                    <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="PROJECT FAVICON" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                                                    <TextBlock Text="Sync app branding and icons into project web / source folders" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ui:Button Name="BtnUpdateCurrentFavicon" Grid.Column="1" Content="Update Favicon"
                                                           Icon="{ui:SymbolIcon ArrowClockwise16}"
                                                           Appearance="Secondary" Padding="10,4" FontSize="12"
                                                           Click="BtnUpdateCurrentFavicon_Click"/>
                                            </Grid>

                                            <TextBlock Text="Project Favicon Path (Optional - defaults to relative project path e.g. wwwroot\favicon.ico)" Margin="0,0,0,3" Foreground="#94A3B8" FontSize="12"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Name="TxtFaviconPath" PlaceholderText="wwwroot\favicon.ico"
                                                            TextChanged="Config_TextChanged" Margin="0,0,4,0"/>
                                                <ui:Button Name="BtnBrowseFavicon" Grid.Column="1" Content="..."
                                                           Appearance="Secondary" Padding="8,4"
                                                           Click="BtnBrowseFavicon_Click"/>
                                            </Grid>
                                            <TextBlock Text="Copies generated favicon (.ico, .png, or .svg) to this app's project and updates &lt;ApplicationIcon&gt; in .csproj files."
                                                       Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
