<ui:FluentWindow x:Class="Catalyst.Windows.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Catalyst - Color Picker" Height="530" Width="380"
        Icon="pack://application:,,,/Catalyst;component/favicon.ico"
        MinWidth="360" MinHeight="500"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Color Picker" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Catalyst;component/favicon.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,10" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="320">
                <!-- Color Wheel Canvas Container -->
                <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <Grid Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Name="ImgColorWheel" Width="220" Height="220" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas Name="WheelCanvas" Width="220" Height="220" Background="Transparent"
                                Cursor="Cross"
                                MouseLeftButtonDown="WheelCanvas_MouseDown"
                                MouseMove="WheelCanvas_MouseMove"
                                MouseLeftButtonUp="WheelCanvas_MouseUp">
                            <Ellipse Name="WheelSelector" Width="16" Height="16"
                                     Stroke="White" StrokeThickness="2"
                                     Fill="Transparent"
                                     IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Brightness Slider -->
                <TextBlock Text="Brightness" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,12">
                    <Border Name="BrightnessTrack" Height="14" CornerRadius="7" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                    <Slider Name="SliderBrightness" Minimum="0" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.1"
                            ValueChanged="SliderBrightness_ValueChanged"
                            VerticalAlignment="Center" Margin="-4,0,-4,0" Opacity="0.85"/>
                </Grid>

                <!-- Current / Initial Color Preview and Hex -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preview Swatches -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border Name="CurrentColorBox" Width="44" Height="34" CornerRadius="6" BorderBrush="#40FFFFFF" BorderThickness="1" ToolTip="Selected Color"/>
                    </StackPanel>

                    <!-- Hex Input -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Hex Code" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ui:TextBox Name="TxtHex" PlaceholderText="#1E88E4" TextChanged="TxtHex_TextChanged" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- RGB Inputs -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,4,0" Width="36">
                            <TextBlock Text="R" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <ui:TextBox Name="TxtR" Text="30" TextChanged="Rgb_TextChanged" HorizontalContentAlignment="Center" FontSize="11" Padding="2"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,4,0" Width="36">
                            <TextBlock Text="G" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <ui:TextBox Name="TxtG" Text="136" TextChanged="Rgb_TextChanged" HorizontalContentAlignment="Center" FontSize="11" Padding="2"/>
                        </StackPanel>
                        <StackPanel Width="36">
                            <TextBlock Text="B" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <ui:TextBox Name="TxtB" Text="228" TextChanged="Rgb_TextChanged" HorizontalContentAlignment="Center" FontSize="11" Padding="2"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Preset Palette Swatches -->
                <TextBlock Text="Palette Presets" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <WrapPanel Name="PresetSwatchesPanel" Margin="0,0,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#10FFFFFF" Padding="16,10" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0">
            <DockPanel>
                <ui:Button Name="BtnSelect" Content="Select Color" Appearance="Success" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnSelect_Click"/>
                <ui:Button Name="BtnCancel" Content="Cancel" Appearance="Secondary" DockPanel.Dock="Right" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
